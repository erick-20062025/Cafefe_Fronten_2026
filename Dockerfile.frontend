FROM debian:stable
LABEL org.opencontainers.image.title="Cafefe frontend PPI115"
RUN apt-get update && apt-get install -y --no-install-recommends nginx ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* /var/www/html/*
COPY docker/frontend/nginx.conf /etc/nginx/nginx.conf
COPY --chmod=755 docker/frontend/iniciar.sh /usr/local/bin/iniciar-cafefe
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fsS http://127.0.0.1/index.html > /dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/iniciar-cafefe"]
